# Public browser values. Build production with authentication required.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is an alternative, not the service role.
VITE_SUPABASE_ANON_KEY=
VITE_BASE_PATH=/painel/
VITE_REQUIRE_AUTH=true
# Optional test/development override; production uses the same origin.
VITE_API_BASE_URL=

# Edge runtime only. Supabase injects the three platform values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TUNA_TEAM_ID=8764e489-d6d6-4378-a646-4d93ced7a75c
TUNA_ALLOWED_ORIGINS=https://tunastream-ofc.lovable.app,https://id-preview--61800de5-dce3-4499-91d0-8d8e1837cd2c.lovable.app
# Generate once; preserve across deploys, never put in VITE_ values.
TUNA_RATE_SECRET=
WHATSAPP_CONTACT_HASH_SECRET=
TUNA_CRON_SECRET=

# Optional Google geography. Measurement ID belongs in website tracker config.
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional Instagram account insights. Explicit supported app API version.
META_GRAPH_VERSION=
INSTAGRAM_LOGIN_MODE=instagram
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Optional official WhatsApp delivery/receiver. Receiver remains unset for common app.
META_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_RECEIVING_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_REPORT_SENDER_PHONE_NUMBER_ID=
WHATSAPP_REPORT_RECIPIENT=
WHATSAPP_SITE_TEMPLATE=
WHATSAPP_INSTAGRAM_TEMPLATE=
